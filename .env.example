# URL base de la API (incluye /api/v1). Ver docs/07-ambientes-y-pruebas.md en el handoff.
# Mock local (npm run mock):
VITE_API_BASE_URL=http://localhost:3000/api/v1
# Backend en vivo: la URL del túnel cambia al reiniciar; consúltala en docs/07 del handoff.
# VITE_API_BASE_URL=https://<tunel>.trycloudflare.com/api/v1

# Globo lunar (D-011, docs/11 del handoff). Sin valor, el fondo global usa un placeholder.
# En desarrollo el globo corre en 5174 (en su repo: npm run dev -- --port 5174).
# VITE_GLOBE_URL=http://localhost:5174/
